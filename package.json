{
  "name": "yamr",
  "version": "0.1.0",
  "description": "Yet Another Markdown Renderer: a small local server that renders markdown in your browser with live reload.",
  "type": "module",
  "bin": {
    "yamr": "bin/yamr.js"
  },
  "main": "src/server.js",
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/yamr.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "markdown",
    "preview",
    "live-reload",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "highlight.js": "^11.12.0",
    "marked": "^18.0.13",
    "marked-highlight": "^2.2.4",
    "morphdom": "^2.7.8"
  },
  "author": "Jonathan Van Schenck <jvschenck@novadynamics.com>"
}
